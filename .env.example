# Memorizar backend — variables de entorno.
# Copia a `.env` y ajusta. docker-compose las lee automáticamente.
# Ningún valor es secreto por defecto; los únicos sensibles son las
# credenciales FCM (archivo aparte, no se commitea).

# Dirección de escucha del API. Por defecto :8080.
MEMORIZAR_API_ADDR=:8080

# Driver de persistencia: "sqlite" (recomendado, default) o "file" (JSON).
MEMORIZAR_STORE=sqlite

# Ruta del archivo SQLite (driver sqlite). En docker apunta al volumen /data.
MEMORIZAR_SQLITE_PATH=/data/memorizar.db

# Ruta del JSON (driver file). Solo se usa si MEMORIZAR_STORE=file.
# MEMORIZAR_SOCIAL_STORE=/data/social_store.json

# Correos con rol de moderador (coma-separados). Vacío = nadie modera.
MEMORIZAR_MODERATOR_EMAILS=

# Push real (FCM HTTP v1): ruta al service account JSON de tu proyecto
# Firebase. Si está vacío/ausente, el server usa LogNotifier (sin push real),
# y arranca igual. Ver DEPLOY.md y el handoff de FCM.
# MEMORIZAR_FCM_CREDENTIALS_FILE=/secrets/firebase-sa.json
